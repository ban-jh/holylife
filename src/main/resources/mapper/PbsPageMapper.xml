<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.shaloman.pj.content.pbs.mapper.PbsPageMapper">

    <!-- ResultMap -->
    <resultMap id="pageResultMap" type="org.shaloman.pj.content.pbs.domain.PbsPage">
        <id property="pageId" column="page_id"/>
        <result property="folderId" column="folder_id"/>
        <result property="userId" column="user_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="status" column="status"/>
        <result property="testament" column="testament"/>
        <result property="bookCode" column="book_code"/>
        <result property="chapterFrom" column="chapter_from"/>
        <result property="verseFrom" column="verse_from"/>
        <result property="chapterTo" column="chapter_to"/>
        <result property="verseTo" column="verse_to"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="publishedAt" column="published_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <collection property="references" ofType="org.shaloman.pj.content.pbs.domain.PbsReference"
                    column="page_id" select="org.shaloman.pj.content.pbs.mapper.PbsReferenceMapper.findByPageId"/>
    </resultMap>

    <!-- 공통 컬럼 -->
    <sql id="commonColumns">
        page_id, folder_id, user_id, title, content, status, testament, book_code,
        chapter_from, verse_from, chapter_to, verse_to, sort_order, published_at,
        created_at, updated_at
    </sql>

    <!-- 전체 조회 -->
    <select id="findAll" resultMap="pageResultMap">
        SELECT <include refid="commonColumns"/>
        FROM pbs_page
        ORDER BY sort_order ASC, page_id DESC
    </select>

    <!-- ID로 조회 (참조 포함) -->
    <select id="findById" resultMap="pageResultMap">
        SELECT <include refid="commonColumns"/>
        FROM pbs_page
        WHERE page_id = #{pageId}
    </select>

    <!-- 폴더 ID로 페이지 목록 조회 -->
    <select id="findByFolderId" resultMap="pageResultMap">
        SELECT <include refid="commonColumns"/>
        FROM pbs_page
        WHERE folder_id = #{folderId}
        ORDER BY sort_order ASC, page_id ASC
    </select>

    <!-- 페이지 등록 (임시 제목으로 새 페이지 생성) -->
    <insert id="insert" parameterType="org.shaloman.pj.content.pbs.domain.PbsPage"
            useGeneratedKeys="true" keyProperty="pageId">
        INSERT INTO pbs_page (
            folder_id, user_id, title, content, status, testament, book_code,
            chapter_from, verse_from, chapter_to, verse_to, sort_order
        ) VALUES (
            #{folderId}, #{userId},
            <choose>
                <when test="title != null">#{title}</when>
                <otherwise>'새 페이지'</otherwise>
            </choose>,
            <choose>
                <when test="content != null">#{content}</when>
                <otherwise>''</otherwise>
            </choose>,
            <choose>
                <when test="status != null">#{status}</when>
                <otherwise>'DRAFT'</otherwise>
            </choose>,
            #{testament}, #{bookCode}, #{chapterFrom}, #{verseFrom},
            #{chapterTo}, #{verseTo},
            <choose>
                <when test="sortOrder != null">#{sortOrder}</when>
                <otherwise>0</otherwise>
            </choose>
        )
    </insert>

    <!-- 페이지 전체 수정 (동적 SET) -->
    <update id="update" parameterType="org.shaloman.pj.content.pbs.domain.PbsPage">
        UPDATE pbs_page
        <set>
            <if test="folderId != null">folder_id = #{folderId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="title != null">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="status != null">status = #{status},</if>
            <if test="testament != null">testament = #{testament},</if>
            <if test="bookCode != null">book_code = #{bookCode},</if>
            <if test="chapterFrom != null">chapter_from = #{chapterFrom},</if>
            <if test="verseFrom != null">verse_from = #{verseFrom},</if>
            <if test="chapterTo != null">chapter_to = #{chapterTo},</if>
            <if test="verseTo != null">verse_to = #{verseTo},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="publishedAt != null">published_at = #{publishedAt},</if>
            updated_at = NOW()
        </set>
        WHERE page_id = #{pageId}
    </update>

    <!-- 본문 내용 수정 (자동저장용) -->
    <update id="updateContent">
        UPDATE pbs_page
        SET content = #{content}, updated_at = NOW()
        WHERE page_id = #{pageId}
    </update>

    <!-- 상태 변경 (배포용: PUBLISHED 시 published_at 자동 설정) -->
    <update id="updateStatus">
        UPDATE pbs_page
        SET status = #{status},
            <if test="status == 'PUBLISHED'">published_at = NOW(),</if>
            updated_at = NOW()
        WHERE page_id = #{pageId}
    </update>

    <!-- 페이지 삭제 -->
    <delete id="deleteById">
        DELETE FROM pbs_page WHERE page_id = #{pageId}
    </delete>

</mapper>
