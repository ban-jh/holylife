<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.shaloman.pj.content.pbs.mapper.PbsReferenceMapper">

    <!-- ResultMap -->
    <resultMap id="referenceResultMap" type="org.shaloman.pj.content.pbs.domain.PbsReference">
        <id property="refId" column="ref_id"/>
        <result property="pageId" column="page_id"/>
        <result property="refType" column="ref_type"/>
        <result property="refName" column="ref_name"/>
        <result property="refUrl" column="ref_url"/>
        <result property="filePath" column="file_path"/>
        <result property="fileSize" column="file_size"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 공통 컬럼 -->
    <sql id="commonColumns">
        ref_id, page_id, ref_type, ref_name, ref_url, file_path, file_size, created_at
    </sql>

    <!-- 페이지 ID로 참조 목록 조회 -->
    <select id="findByPageId" resultMap="referenceResultMap">
        SELECT <include refid="commonColumns"/>
        FROM pbs_reference
        WHERE page_id = #{pageId}
        ORDER BY ref_id ASC
    </select>

    <!-- 참조 등록 (useGeneratedKeys로 PK 자동 주입) -->
    <insert id="insert" parameterType="org.shaloman.pj.content.pbs.domain.PbsReference"
            useGeneratedKeys="true" keyProperty="refId">
        INSERT INTO pbs_reference (
            page_id, ref_type, ref_name, ref_url, file_path, file_size
        ) VALUES (
            #{pageId}, #{refType}, #{refName}, #{refUrl}, #{filePath}, #{fileSize}
        )
    </insert>

    <!-- 참조 ID로 삭제 -->
    <delete id="deleteById">
        DELETE FROM pbs_reference WHERE ref_id = #{refId}
    </delete>

    <!-- 페이지 ID로 모든 참조 삭제 -->
    <delete id="deleteByPageId">
        DELETE FROM pbs_reference WHERE page_id = #{pageId}
    </delete>

</mapper>
