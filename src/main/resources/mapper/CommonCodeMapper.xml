<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.shaloman.pj.mapper.CommonCodeMapper">

    <!-- ResultMap -->
    <resultMap id="commonCodeResultMap" type="org.shaloman.pj.domain.CommonCode">
        <id property="codeId" column="code_id"/>
        <result property="groupCode" column="group_code"/>
        <result property="code" column="code"/>
        <result property="codeName" column="code_name"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="useYn" column="use_yn"/>
        <result property="modifiedDate" column="modified_date"/>
    </resultMap>

    <!-- 공통 컬럼 -->
    <sql id="commonColumns">
        code_id, group_code, code, code_name, sort_order, use_yn, modified_date
    </sql>

    <!-- 전체 조회 -->
    <select id="findAll" resultMap="commonCodeResultMap">
        SELECT <include refid="commonColumns"/>
        FROM common_codes
        ORDER BY sort_order, code_id
    </select>

    <!-- 그룹 코드로 조회 -->
    <select id="findByGroupCode" resultMap="commonCodeResultMap">
        SELECT <include refid="commonColumns"/>
        FROM common_codes
        WHERE group_code = #{groupCode}
        ORDER BY sort_order, code_id
    </select>

    <!-- 그룹 코드 + 키워드 검색 -->
    <select id="findByGroupCodeAndKeyword" resultMap="commonCodeResultMap">
        SELECT <include refid="commonColumns"/>
        FROM common_codes
        WHERE group_code = #{groupCode}
        <if test="keyword != null and keyword != ''">
            AND (code LIKE CONCAT('%', #{keyword}, '%')
                 OR code_name LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        ORDER BY sort_order, code_id
    </select>

    <!-- ID로 조회 -->
    <select id="findById" resultMap="commonCodeResultMap">
        SELECT <include refid="commonColumns"/>
        FROM common_codes
        WHERE code_id = #{codeId}
    </select>

    <!-- 등록 -->
    <insert id="insert" parameterType="org.shaloman.pj.domain.CommonCode" useGeneratedKeys="true" keyProperty="codeId">
        INSERT INTO common_codes (
            group_code, code, code_name, sort_order, use_yn
        ) VALUES (
            #{groupCode}, #{code}, #{codeName},
            <choose>
                <when test="sortOrder != null">#{sortOrder}</when>
                <otherwise>0</otherwise>
            </choose>,
            <choose>
                <when test="useYn != null">#{useYn}</when>
                <otherwise>true</otherwise>
            </choose>
        )
    </insert>

    <!-- 수정 -->
    <update id="update" parameterType="org.shaloman.pj.domain.CommonCode">
        UPDATE common_codes
        <set>
            <if test="groupCode != null">group_code = #{groupCode},</if>
            <if test="code != null">code = #{code},</if>
            <if test="codeName != null">code_name = #{codeName},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="useYn != null">use_yn = #{useYn},</if>
        </set>
        WHERE code_id = #{codeId}
    </update>

    <!-- 삭제 -->
    <delete id="deleteById">
        DELETE FROM common_codes WHERE code_id = #{codeId}
    </delete>

    <!-- 그룹 코드로 전체 삭제 -->
    <delete id="deleteByGroupCode">
        DELETE FROM common_codes WHERE group_code = #{groupCode}
    </delete>

    <!-- 총 수 -->
    <select id="count" resultType="int">
        SELECT COUNT(*) FROM common_codes
    </select>

</mapper>