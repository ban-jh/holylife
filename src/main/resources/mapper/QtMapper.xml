<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.shaloman.pj.mapper.QtMapper">

    <!-- ResultMap -->
    <resultMap id="qtResultMap" type="org.shaloman.pj.domain.Qt">
        <id property="qtId" column="qt_id"/>
        <result property="userId" column="user_id"/>
        <result property="title" column="title"/>
        <result property="qtDate" column="qt_date"/>
        <result property="bibleRef" column="bible_ref"/>
        <result property="bibleText" column="bible_text"/>
        <result property="content" column="content"/>
        <result property="visibility" column="visibility"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 공통 컬럼 -->
    <sql id="commonColumns">
        qt_id, user_id, title, qt_date, bible_ref, bible_text,
        content, visibility, created_at, updated_at
    </sql>

    <!-- 전체 조회 (큐티 날짜 내림차순) -->
    <select id="findAll" resultMap="qtResultMap">
        SELECT <include refid="commonColumns"/>
        FROM qts
        ORDER BY qt_date DESC
    </select>

    <!-- 사용자 ID로 조회 -->
    <select id="findByUserId" resultMap="qtResultMap">
        SELECT <include refid="commonColumns"/>
        FROM qts
        WHERE user_id = #{userId}
        ORDER BY qt_date DESC
    </select>

    <!-- ID로 조회 -->
    <select id="findById" resultMap="qtResultMap">
        SELECT <include refid="commonColumns"/>
        FROM qts
        WHERE qt_id = #{qtId}
    </select>

    <!-- 사용자 ID + 날짜로 조회 -->
    <select id="findByUserIdAndDate" resultMap="qtResultMap">
        SELECT <include refid="commonColumns"/>
        FROM qts
        WHERE user_id = #{userId} AND qt_date = #{qtDate}
    </select>

    <!-- 큐티 등록 (useGeneratedKeys로 PK 자동 주입) -->
    <insert id="insert" parameterType="org.shaloman.pj.domain.Qt"
            useGeneratedKeys="true" keyProperty="qtId">
        INSERT INTO qts (
            user_id, title, qt_date, bible_ref, bible_text,
            content, visibility
        ) VALUES (
            #{userId}, #{title}, #{qtDate}, #{bibleRef}, #{bibleText},
            #{content}, #{visibility}
        )
    </insert>

    <!-- 큐티 수정 (동적 SET, null 체크) -->
    <update id="update" parameterType="org.shaloman.pj.domain.Qt">
        UPDATE qts
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="title != null">title = #{title},</if>
            <if test="qtDate != null">qt_date = #{qtDate},</if>
            <if test="bibleRef != null">bible_ref = #{bibleRef},</if>
            <if test="bibleText != null">bible_text = #{bibleText},</if>
            <if test="content != null">content = #{content},</if>
            <if test="visibility != null">visibility = #{visibility},</if>
            updated_at = NOW()
        </set>
        WHERE qt_id = #{qtId}
    </update>

    <!-- 큐티 삭제 -->
    <delete id="deleteById">
        DELETE FROM qts WHERE qt_id = #{qtId}
    </delete>

</mapper>